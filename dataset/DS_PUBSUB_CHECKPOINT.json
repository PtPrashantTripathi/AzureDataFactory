			"referenceName": "LS_AzureDataLakeStorage01",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"collectionname": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": {
					"value": "@concat('control/pubsubdataload/checkpoint/',toLower(dataset().collectionname),'/pubsubwrite/')",
					"type": "Expression"
				},
				"fileSystem": "raw"
			}
		}
	}
}