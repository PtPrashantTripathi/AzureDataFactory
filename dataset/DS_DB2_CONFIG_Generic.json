			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "Generic_DB2_CONFIG.csv",
				"folderPath": {
					"value": "@concat('configuration/',dataset().Domain,'/raw')",
					"type": "Expression"
				},
				"fileSystem": "raw"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}
