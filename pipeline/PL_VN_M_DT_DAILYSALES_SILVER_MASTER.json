					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_STAGE_BUILDER",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"write_mode": {
							"value": "@pipeline().parameters.save_mode",
							"type": "Expression"
						},
						"onboarder_notebook_path": {
							"value": "@pipeline().parameters.notebook_path",
							"type": "Expression"
						},
						"partition_keys": {
							"value": "@pipeline().parameters.partition_keys",
							"type": "Expression"
						},
						"layer": "Silver",
						"stage": "Fact"
					}
				}
			}
		],
		"parameters": {
			"notebook_path": {
				"type": "string",
