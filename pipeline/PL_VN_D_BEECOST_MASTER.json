{
	"name": "PL_VN_D_BEECOST_MASTER",
	"properties": {
		"activities": [
			{
				"name": "AT_SET_LandingDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "landing_date",
					"value": {
						"value": "@formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EXE_Onboarder-Landed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_LANDED",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_container": {
							"value": "@pipeline().parameters.source_container",
							"type": "Expression"
						},
						"source_directory": {
							"value": "@pipeline().parameters.source_directory",
							"type": "Expression"
						},
						"source_file_name": {
							"value": "@pipeline().parameters.source_file_name",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"object_type": {
							"value": "@pipeline().parameters.object_type",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"onboarder_notebook_path": "/Shared/notebooks/Universal_Landed",
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"save_mode": "overwrite"
					}
				}
			},
			{
				"name": "EXE_Onboarder-Processed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "EXE_Onboarder-Landed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_PROCESSED",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"write_mode": "upsert",
						"onboarder_notebook_path": "/Shared/notebooks/Universal_Processed"
					}
				}
			}
		],
		"parameters": {
			"source_directory": {
				"type": "string",
				"defaultValue": "DataDisplay"
			},
			"source_container": {
				"type": "string",
				"defaultValue": "acacy"
			},
			"object_name": {
				"type": "string",
				"defaultValue": "DataDisplay"
			},
			"object_type": {
				"type": "string",
				"defaultValue": "csv"
			},
			"primary_keys": {
				"type": "string",
				"defaultValue": "Guid"
			},
			"partition_keys": {
				"type": "string",
				"defaultValue": "YYYY,MM,DD"
			},
			"time_zone": {
				"type": "string",
				"defaultValue": "SE Asia Standard Time"
			},
			"country_code": {
				"type": "string",
				"defaultValue": "VN"
			},
			"source_name": {
				"type": "string",
				"defaultValue": "ACACY"
			},
			"source_file_name": {
				"type": "string"
			}
		},
		"variables": {
			"landing_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "VN/BEECOST"
		},
		"annotations": []
	}
}
