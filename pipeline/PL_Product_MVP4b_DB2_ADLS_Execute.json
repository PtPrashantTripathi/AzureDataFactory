{
	"name": "PL_Product_MVP4b_DB2_ADLS_Execute",
	"properties": {
		"activities": [
			{
				"name": "LKP_ALL_TABLES",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Config_Lookup",
						"type": "DatasetReference",
						"parameters": {
							"filename": "MVP4b_DB2_DB_CONFIG.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Copy_each_table_to_azure_datalake",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_ALL_TABLES",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_ALL_TABLES').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 2,
					"activities": [
						{
							"name": "Copy_data_from_DB2_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "Db2Source",
									"query": {
										"value": "SELECT * FROM @{item().Database}.@{item().SourceTableName} FOR FETCH ONLY WITH UR",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DB_Connectivity",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_OutPut_CSV",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@concat(item().fileName,'_',formatDateTime(utcnow(),'yyyyMMdd'))",
											"type": "Expression"
										},
										"folderName": {
											"value": "@concat(item().folderName,'/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
											"type": "Expression"
										},
										"domain": {
											"value": "@item().domain",
											"type": "Expression"
										},
										"sourceSystem": {
											"value": "@item().SourceSystem",
											"type": "Expression"
										},
										"tableName": {
											"value": "@item().SourceTableName",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "NB_Raw_To_Cleanse",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "NB_getRawFiles",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Published_Customer/DATA/MASTER/MVP4b_master_raw_to_cleanse",
								"baseParameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"rawFilePath": {
										"value": "@concat(item().folderName,'/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_DS3",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "NB_getRawFiles",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "Copy_data_from_DB2_to_ADLS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Published_Customer/DATA/MASTER/getMVP4bRawFiles",
								"baseParameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"rowsCopied": {
										"value": "@string(activity('Copy_data_from_DB2_to_ADLS').output.rowsCopied)",
										"type": "Expression"
									},
									"Watermark_Value": {
										"value": "@utcnow()",
										"type": "Expression"
									},
									"timestampIngested": {
										"value": "@utcnow()",
										"type": "Expression"
									},
									"filePath": {
										"value": "@concat(item().folderName,'/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_DS3",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "MerchSalesKeyInformation",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy_each_table_to_azure_datalake",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/GRC/Product/MerchSalesKeyInformation",
					"baseParameters": {
						"rawFilePath": {
							"value": "@concat('full/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "StoreSalesKey",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy_each_table_to_azure_datalake",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/GRC/Product/StoreSalesKey",
					"baseParameters": {
						"rawFilePath": {
							"value": "@concat('full/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			}
		],
		"folder": {
			"name": "Digital-Merchandising/DB2/SalesKeyInfo"
		},
		"annotations": []
	}
}
