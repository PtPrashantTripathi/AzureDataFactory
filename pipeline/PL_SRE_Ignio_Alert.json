{
	"name": "PL_SRE_Ignio_Alert",
	"properties": {
		"activities": [
			{
				"name": "Environment_Selection",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/ALERT/IGNIO_ENVIRONMENT_SELECTION"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_DS3",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Get Secret",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Environment_Selection",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('Environment_Selection').output.runOutput.URL1",
						"type": "Expression"
					},
					"method": "GET",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Ignio Call",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Alert_JSON_Config_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('Environment_Selection').output.runOutput.URL",
						"type": "Expression"
					},
					"method": "POST",
					"headers": {
						"Ocp-Apim-Subscription-Key": {
							"value": "@activity('Get Secret').output.value",
							"type": "Expression"
						}
					},
					"body": {
						"value": "[\n  {\n    \"description\": \"ADF Pipeline has failed.Please Check the pipeline.\",\n    \"faultName\": \"ADF Pipeline has failed.Please Check the pipeline.\",\n    \"priority\": \"High\",\n    \"properties\": {\n      \"AssignedGroup\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.Assigned_Group}\",\n      \"AssignedSupportOrganization\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.Support_Group}\",\n      \"Ciname\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.CI_Name}\",\n      \"Impact\": \"2-Significant/Large\",\n      \"PipelineName\":\"@{pipeline().parameters.PipelineName}\",\n      \"PipelineRunID\" :\"@{pipeline().parameters.RunID}\",\n      \"ProductName\": \"EDaA - Product 360 (Product)\",\n      \"ServiceCI\": \"Meijer Services\",\n      \"Summary\": \"ADF Pipeline has failed.Please Check the pipeline.\", \n      \"Urgency\": \"2-High\"\n    },\n    \"rootEntity\": \"RemedyCreate\",\n    \"severity\": \"High\",\n    \"source\": \"ignioAlertDetection\"\n  }\n]\n",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com"
					}
				}
			},
			{
				"name": "Alert_JSON_Config_Files",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Get Secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_JSON_Config_LookUp",
						"type": "DatasetReference"
					}
				}
			}
		],
		"parameters": {
			"PipelineName": {
				"type": "string"
			},
			"RunID": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/SRE_Template"
		},
		"annotations": []
	}
}
