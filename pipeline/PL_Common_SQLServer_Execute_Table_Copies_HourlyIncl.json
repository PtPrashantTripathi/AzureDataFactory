{
	"name": "PL_Common_SQLServer_Execute_Table_Copies_HourlyIncl",
	"properties": {
		"description": "Master pipeline Incremental load for PMM (Sqlserver) and DRAdmin for Product Minibatch Implementation which will run hourly. ",
		"activities": [
			{
				"name": "FOREACH_SRC_TABLES",
				"description": "Process each entry from the configuration file",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "ExecutePL_SRCSQLServer_Generic_Copy_Incl",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_SQLServer_Generic_Copy_Incl",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"databaseName": {
										"value": "@item().DatabaseName",
										"type": "Expression"
									},
									"serverInstance": {
										"value": "@item().ServerInstance",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"folderName": {
										"value": "@concat('delta/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'),'/','Hour=',formatDateTime(utcnow(),'HH'))",
										"type": "Expression"
									},
									"watermarkColumnName": {
										"value": "@item().WatermarkColumnName",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat(item().SourceTableName,'-',formatDateTime(utcnow()) )",
										"type": "Expression"
									},
									"userName": {
										"value": "@item().UserName",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "ExecutePL_Common_Generic_Cleanse",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "ExecutePL_SRCSQLServer_Generic_Copy_Incl",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Generic_Cleanse",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "LKP_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_SQL_CONFIG_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "PRODUCT_HOURLY_SQLSERVER_DB_CONFIGURATION.CSV"
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"p_SourceSystem": {
				"type": "string",
				"defaultValue": "PMM"
			},
			"p_DatabaseName": {
				"type": "string",
				"defaultValue": "Product"
			}
		},
		"folder": {
			"name": "Digital-Merchandising/PRODUCT_MINIBATCH_INGESTION"
		},
		"annotations": []
	}
}
