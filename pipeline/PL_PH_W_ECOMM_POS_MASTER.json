								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "@concat('SELECT * FROM `philippines_dcom_pos` WHERE order_date >= ''', formatDateTime(addDays(utcNow(), -14), 'yyyy-MM-dd'), '''')\n",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "ParquetSink",
