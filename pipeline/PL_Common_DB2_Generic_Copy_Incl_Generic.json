			{
				"name": "Databricks Notebook for cleansing_copy1",
				"description": "Registering the log details in a delta table using databricks activity",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "COPY_SRC_DB2_DATA_TO_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published/DATA/CLEANSE/getRawFiles",
					"baseParameters": {
						"tableName": {
							"value": "@pipeline().parameters.tableName",
							"type": "Expression"
						},
						"fileName": {
							"value": "@concat(pipeline().parameters.fileName,'.csv')",
							"type": "Expression"
						},
						"filePath": {
							"value": "@concat('data/',pipeline().parameters.domain,'/',pipeline().parameters.sourceSystem,'/',pipeline().parameters.tableName,'/',pipeline().parameters.folderName,'/')",
							"type": "Expression"
						},
						"timestampIngested": {
							"value": "@utcnow()",
							"type": "Expression"
						},
						"rowsCopied": {
							"value": "@string(activity('COPY_SRC_DB2_DATA_TO_ADLS').output.rowsCopied)",
							"type": "Expression"
						},
						"domain": {
							"value": "@pipeline().parameters.domain",
							"type": "Expression"
						},
						"sourceSystem": {
							"value": "@pipeline().parameters.sourceSystem",
							"type": "Expression"
						},
						"Watermark_Value": {
							"value": "@activity('LKP_GET_MAXDATE').output.firstRow.max_updated_time",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"databaseName": {
				"type": "string"
			},
			"dbvalue": {
