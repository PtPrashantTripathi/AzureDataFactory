						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_COMM_PREPROCESS_CSV",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							}
						}
					}
				}
			},
