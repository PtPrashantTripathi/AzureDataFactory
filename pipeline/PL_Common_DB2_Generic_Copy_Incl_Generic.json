{
	"name": "PL_Common_DB2_Generic_Copy_Incl_Generic",
	"properties": {
		"description": "Generic Copy pipeline for incremental load PMM (DB2) and CFD",
		"activities": [
			{
				"name": "COPY_SRC_DB2_DATA_TO_ADLS",
				"description": "Copy Generic DB2 Data to Data Lake",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LKP_GET_MAXDATE",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LKP_GET_PREV_MAXDATE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OdbcSource",
						"query": {
							"value": "SELECT * FROM @{pipeline().parameters.dbvalue}@{pipeline().parameters.databaseName}.@{pipeline().parameters.tableName}\nWHERE @{pipeline().parameters.watermarkColumnName} > TIMESTAMP_FORMAT(REPLACE('@{activity('LKP_GET_PREV_MAXDATE').output.firstRow.Watermark_Value}','T',''),'YYYY-MM-DD HH24:MI:SS:NNNNNN')  \nand @{pipeline().parameters.watermarkColumnName} <='@{activity('LKP_GET_MAXDATE').output.firstRow.max_updated_time}'\nFOR FETCH ONLY WITH UR",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"parallelCopies": 10
				},
				"inputs": [
					{
						"referenceName": "DS_DB2_Generic",
						"type": "DatasetReference",
						"parameters": {
							"databaseName": {
								"value": "@pipeline().parameters.databaseName",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"userName": {
								"value": "@pipeline().parameters.userName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SINK_Generic_csv",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@pipeline().parameters.fileName",
								"type": "Expression"
							},
							"folderName": {
								"value": "@pipeline().parameters.folderName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LKP_GET_MAXDATE",
				"description": "Get the latest max watermark date from database",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OdbcSource",
						"query": {
							"value": "SELECT max(@{pipeline().parameters.WatermarkColumnName}) as max_updated_time FROM @{pipeline().parameters.dbvalue}@{pipeline().parameters.databaseName}.@{pipeline().parameters.tableName} FOR FETCH ONLY WITH UR",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "DS_DB2_Generic",
						"type": "DatasetReference",
						"parameters": {
							"databaseName": {
								"value": "@pipeline().parameters.databaseName",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"userName": {
								"value": "@pipeline().parameters.userName",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "UPDATE_PREPROCESS_FILE",
