					{
						"activity": "EXEP_LAST_EXECUTION",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:20:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@pipeline().globalParameters.PH_MDL_LOGICAPPS_01",
						"type": "Expression"
					},
					"method": "POST",
					"body": {
						"value": "@concat('{\"body\":\"Files have been successfully uploaded in sharepoint and copied for RRHI FCDS POS Mapping\",\n    \"subject\":\"Sharepoint update status\",\n    \"body_copy_fail\":\"Files have not been uploaded in sharepoint\",\n    \"Logic Apps Case\":\"PHRetailer\",\n    \"Nested\":\"',variables('Nested'),'\",','\n    \"Pipeline Name\":\"',pipeline().Pipeline,'\",','\n    \"to\":\"',variables('receiver'),'\",','\n    \"run_id\":\"',pipeline().RunId,'\",','\n    \"run_date_time\":\"',formatDateTime(utcNow(),'MM-dd-yyyy'),'\",','\n    \"Contains\":\"',variables('Contains'),'\",','\n    \"column_name\":\"',variables('column_name'),'\",','\n    \"Source\":\"',pipeline().parameters.Source,'\",','\n    \"Site\":\"',pipeline().parameters.Site,'\",','\n    \"library_name\":\"',pipeline().parameters.library_name,'\",','\n    \"Blob_Destination\":\"',pipeline().parameters.Blob_Destination,'\",','\n    \"last_execution\":\"',activity('EXEP_LAST_EXECUTION').output.pipelineReturnValue.last_execution,'\"}')",
						"type": "Expression"
					},
					"httpRequestTimeout": "00:10:00"
				}
			},
			{
				"name": "AT_IF_INGEST",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "AT_WEB_CALL_LOGICAPP_COPY",
						"dependencyConditions": [
							"Succeeded"
						]
