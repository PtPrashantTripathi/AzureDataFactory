				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_PH_A_PHRETAILER_RRHIFCDS_GET_LAST_EXECUTION",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"file_name": {
							"value": "@concat('last_execution/',pipeline().parameters.last_execution_file_name)",
							"type": "Expression"
						},
						"source_container": {
							"value": "@pipeline().parameters.source_container",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "AT_ADB_FOLDER",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
