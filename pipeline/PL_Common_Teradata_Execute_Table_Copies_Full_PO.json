{
	"name": "PL_Common_Teradata_Execute_Table_Copies_Full_PO",
	"properties": {
		"description": "This is a test pipeline to understand the ADF process",
		"activities": [
			{
				"name": "LOOKUP_CONFIG",
				"description": "This lookup is for reading the config files from the blob",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_TeraData_CONFIG_SASRetirement_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "TERADATA_DB_CONFIGURATION_PO.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "SET SRC_SYSTEM",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LOOKUP_CONFIG",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "Input SourceSystem",
					"value": {
						"value": "@toUpper(pipeline().parameters.p_SourceSystem)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FILTER SRC_SYSTEM",
				"description": "Filtering the Source System based on the input provided..",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "SET SRC_SYSTEM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LOOKUP_CONFIG').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(and(equals(item().DatabaseName,pipeline().parameters.p_DatabaseName),equals(item().SourceSystem,pipeline().parameters.p_SourceSystem)),equals(variables('Input SourceSystem'),'PO'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FOREACH SRC_SYSTEM",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FILTER SRC_SYSTEM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FILTER SRC_SYSTEM').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Execute PL_SRC_Teradata_Generic_Copy_PO_Full",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Teradata_Generic_Copy_Full_PO",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"WatermarkColumnName": {
										"value": "@item().WatermarkColumnName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"folderName": {
										"value": "@concat('full/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat(item().SourceTableName,'-',formatDateTime(utcnow()) )",
										"type": "Expression"
									},
									"databaseName": {
										"value": "@item().DatabaseName",
										"type": "Expression"
									},
									"PartitionColumn": {
										"value": "@item().PartitionColumn",
										"type": "Expression"
									},
									"queryPattern": {
										"value": "@item().QueryPattern",
										"type": "Expression"
									},
									"WhereClause": {
										"value": "@item().WhereClause",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute PL_Common_Generic_Cleanse_PO",
							"description": "Executing for copy the data into cleansed layer from raw",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute PL_SRC_Teradata_Generic_Copy_PO_Full",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Generic_Cleanse",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Cleansed_To_Staged_Load",
							"description": "Copying data from Cleansed layer to Staged layer",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute PL_Common_Generic_Cleanse_PO",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_NonADRM_PO",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"fullorincl": "F",
									"entity_name": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_SourceSystem": {
				"type": "String"
			},
			"p_DatabaseName": {
				"type": "string"
			}
		},
		"variables": {
			"Input SourceSystem": {
				"type": "String"
			}
		},
		"folder": {
			"name": "ProductAPI/PO"
		},
		"annotations": []
	}
}
