{
	"name": "PL_Common_DataStage_Execute_Table_Copy_Incl_Test",
	"properties": {
		"activities": [
			{
				"name": "LKP_CONFIG_FILE",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "00.01:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_TeraData_CONFIG_Promo_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "TERADATA_DB_CONFIGURATION_DATASTAGE.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_TBL",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().SourceSystem,pipeline().parameters.p_SourceSystem),equals(item().DatabaseName,pipeline().parameters.p_DatabaseName))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLTR_TBL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLTR_TBL').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Execute PL_Common_DataStage_Generic_Copy_Full_Promo",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_DataStage_Generic_Copy_Incl_Test",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"filepath": {
										"value": "@item().DataStageFilePath",
										"type": "Expression"
									},
									"folderName": {
										"value": "@concat('delta/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'),'/','Hour=',formatDateTime(utcnow(),'HH'))",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat(item().SourceTableName,'-',formatDateTime(utcnow()) )",
										"type": "Expression"
									},
									"hostid": {
										"value": "@item().HostName",
										"type": "Expression"
									},
									"utcnow": {
										"value": "@utcnow()",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute PL_Generic_Cleanse",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute PL_Common_DataStage_Generic_Copy_Full_Promo",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Generic_Cleanse",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_SourceSystem": {
				"type": "string"
			},
			"p_DatabaseName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Digital-Merchandising/TERADATA/DataStage/Datastage_Test"
		},
		"annotations": []
	}
}
