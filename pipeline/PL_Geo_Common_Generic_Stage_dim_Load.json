{
	"name": "PL_Geo_Common_Generic_Stage_dimension_Load",
	"properties": {
		"description": "Generic Pipeline Geo Dimension load",
		"activities": [
			{
				"name": "NB_STAGING_GEO",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "FLTR_Geo_Cluster_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Pos/Geo/STAGE/DimensionGeo"
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "LKP_CLUSTER_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_GEO_CONFIG_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "GEO_DATABRICKS_CLUSTER_CONFIGURATION.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_Geo_Cluster_Config",
				"description": "Filter for Source tables in the configuration file",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CLUSTER_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CLUSTER_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().Domain,'Geo')\n,equals(item().PipelineName,'PL_Geo_Common_Generic_Stage_dimension_Load'))",
						"type": "Expression"
					}
				}
			}
		],
		"folder": {
			"name": "Geo/Stage"
		},
		"annotations": [],
		"lastPublishTime": "2021-03-09T09:28:41Z"
	}
}