{
	"name": "PL_SaveIPOPCosmosToStage",
	"properties": {
		"activities": [
			{
				"name": "Save Cosmos Data to Stage",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Execute Increase RU for ILC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "00.02:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/GRC/ILC/SaveIPOPToStage",
					"baseParameters": {
						"stores": {
							"value": "@string(pipeline().parameters.store_list)",
							"type": "Expression"
						},
						"requestor": "STME",
						"filter_cond": {
							"value": "@coalesce(null,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_ILC",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Execute Increase RU for ILC",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ScaleCosmos_Increase_RU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_CollectionName": {
							"value": "ILCLocationLevel",
							"type": "Expression"
						},
						"fullorincl": {
							"value": "F",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Decrease RU for ILC",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Save Cosmos Data to Stage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ScaleCosmos_Decrease_RU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_CollectionName": {
							"value": "ILCLocationLevel",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"store_list": {
				"type": "array"
			}
		},
		"folder": {
			"name": "ProductAPI/ILC"
		},
		"annotations": []
	}
}
