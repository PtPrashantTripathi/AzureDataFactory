{
	"name": "PL_Export_To_Cosmos_StoreItem",
	"properties": {
		"activities": [
			{
				"name": "NB_Cosmos_Load",
				"description": "Master notebook to process each entity passed as parameter",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "FLTR_Collection_RU_Decrease",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/GRC/Product_CosmosDB/RunCosmosNotebook",
					"baseParameters": {
						"collectionname": {
							"value": "@pipeline().parameters.collectionname",
							"type": "Expression"
						},
						"fullorincl": {
							"value": "@pipeline().parameters.fullorincl",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_Connector",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "GetCommonAPISecret",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "NB_Cosmos_Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_GetCommonAPISecret_URL",
						"type": "Expression"
					},
					"method": "GET",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "LKP_ScaleCosmos_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "configuration/Product",
							"wildcardFileName": "Product_StoreItem_ScaleCosmosDB_config.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_ScaleCosmos_Product",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_Collection_RU_Decrease",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_ScaleCosmos_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_ScaleCosmos_Config').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(and(equals(item().CollectionName,pipeline().parameters.collectionname),equals(item().DataFactoryName,pipeline().DataFactory)),equals(item().OperationRUCount,'Decrease'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ScaleCosmosDB",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "GetCommonAPISecret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_ScaleCosmosDB_URL",
						"type": "Expression"
					},
					"method": "POST",
					"headers": {
						"Ocp-Apim-Subscription-Key": {
							"value": "@activity('GetCommonAPISecret').output.value",
							"type": "Expression"
						}
					},
					"body": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_ScaleCosmosDB_Body",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com"
					}
				}
			},
			{
				"name": "GetCommonAPISecret_fail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "NB_Cosmos_Load",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_GetCommonAPISecret_URL",
						"type": "Expression"
					},
					"method": "GET",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "ScaleCosmosDB_fail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "GetCommonAPISecret_fail",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_ScaleCosmosDB_URL",
						"type": "Expression"
					},
					"method": "POST",
					"headers": {
						"Ocp-Apim-Subscription-Key": {
							"value": "@activity('GetCommonAPISecret_fail').output.value",
							"type": "Expression"
						}
					},
					"body": {
						"value": "@activity('FLTR_Collection_RU_Decrease').output.value[0].p_ScaleCosmosDB_Body",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com"
					}
				}
			}
		],
		"parameters": {
			"collectionname": {
				"type": "string"
			},
			"fullorincl": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/BOH"
		},
		"annotations": [],
		"lastPublishTime": "2021-03-03T10:59:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
