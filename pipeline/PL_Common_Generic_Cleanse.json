{
	"name": "PL_Common_Generic_Cleanse",
	"properties": {
		"description": "Generic Cleansing Pipeline",
		"activities": [
			{
				"name": "NB_CLNSNG",
				"description": "Notebook for carrying out the cleansing activity",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published/DATA/CLEANSE/rawToCleanseDataload",
					"baseParameters": {
						"tableName": {
							"value": "@pipeline().parameters.tableName",
							"type": "Expression"
						},
						"sourceSystem": {
							"value": "@pipeline().parameters.sourceSystem",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_Connector",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"sourceSystem": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Digital-Merchandising/Cleanse"
		},
		"annotations": []
	}
}
