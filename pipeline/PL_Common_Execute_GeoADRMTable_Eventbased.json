{
	"name": "PL_Common_Execute_GeoADRMTable_Eventbased",
	"properties": {
		"activities": [
			{
				"name": "Run the ADRM Pipeline when file Count grt 0",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check Dim_SQL_DB2_Process Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(activity('Check Dim_SQL_DB2_Process Count').output.childItems),0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Reset the Generated File Count",
							"type": "Delete",
							"dependsOn": [
								{
									"activity": "On-Success Generate ADRM Check File",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_Common_Folder",
									"type": "DatasetReference",
									"parameters": {
										"FolderName": "EventBased/Geo/DataIngestion/"
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"wildcardFileName": "*.*",
									"enablePartitionDiscovery": false
								}
							}
						},
						{
							"name": "Execute PL_Geo_ADRM_Data_Load_copy1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Geo_ADRM_Data_Load",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "On-Success Generate ADRM Check File",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Execute PL_Geo_ADRM_Data_Load_copy1",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_COMMON_GenerateFile",
									"type": "DatasetReference",
									"parameters": {
										"fileName": "GeoDimensionLoadEventBased_DummyFile/Dummy.txt"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_COMMON_GenerateFile",
									"type": "DatasetReference",
									"parameters": {
										"fileName": "Geo/ADRMProcess/ADRM_Geo_Process_Check.txt"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Check Dim_SQL_DB2_Process Count",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Common_Folder",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": "EventBased/Geo/DataIngestion/"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Execute PL_Geo_LocationType_ADRM",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Run the ADRM Pipeline when file Count grt 0",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Geo_LocationType_ADRM",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"concurrency": 1,
		"folder": {
			"name": "Geo/Eventbased"
		},
		"annotations": []
	}
}