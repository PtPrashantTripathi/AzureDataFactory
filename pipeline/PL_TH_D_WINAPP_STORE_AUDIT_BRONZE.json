{
	"name": "PL_TH_D_WINAPP_STORE_AUDIT_BRONZE",
	"properties": {
		"activities": [
			{
				"name": "AT_SET_LandingDate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "FTP_copy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "landing_date",
					"value": {
						"value": "@formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EXE_Onboarder-Landed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "PL_SEAID_A_ONBOARDER_GATHER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_LANDED",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_container": {
							"value": "@pipeline().parameters.source_container",
							"type": "Expression"
						},
						"source_directory": {
							"value": "@pipeline().parameters.source_directory",
							"type": "Expression"
						},
						"source_file_name": {
							"value": "@activity('PL_SEAID_A_ONBOARDER_GATHER').output.pipelineReturnValue.FILE_LIST",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"object_type": {
							"value": "@pipeline().parameters.object_type",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"save_mode": "overwrite",
						"partition_keys": {
							"value": "@pipeline().parameters.partition_keys",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "EXE_Onboarder-Processed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "EXE_Onboarder-Landed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_PROCESSED",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"write_mode": "upsert",
						"partition_keys": {
							"value": "@pipeline().parameters.partition_keys",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "PL_SEAID_A_ONBOARDER_GATHER",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_GATHER",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"container": {
							"value": "@pipeline().parameters.source_container",
							"type": "Expression"
						},
						"directory": {
							"value": "@pipeline().parameters.source_directory",
							"type": "Expression"
						},
						"file_type": "csv",
						"file_prefix": "Datalake",
						"layer": "Bronze",
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "FTP_copy",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_TH_D_WIN_FTP_LANDING",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Alert if its fail_ftp_copy",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "FTP_copy",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "EXE_Onboarder-Landed",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "EXE_Onboarder-Processed",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_ALERT",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"is_alert": true,
						"invalid_records": "[\"winapp pipeline failed\"]",
						"data_owner_email": "nopparat.thammathorn@unilever.com",
						"process_owner_email": "pitchayen.srimuang@unilever.com",
						"data_source": "winapp",
						"object_name": "bronze"
					}
				}
			}
		],
		"parameters": {
			"source_directory": {
				"type": "string",
				"defaultValue": "win_app/daily_audit_score"
			},
			"source_container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"object_name": {
				"type": "string",
				"defaultValue": "daily_audit_score_rolling_7_days"
			},
			"object_type": {
				"type": "string",
				"defaultValue": "parquet"
			},
			"primary_keys": {
				"type": "string"
			},
			"partition_keys": {
				"type": "string",
				"defaultValue": "year"
			},
			"time_zone": {
				"type": "string",
				"defaultValue": "SE Asia Standard Time"
			},
			"country_code": {
				"type": "string",
				"defaultValue": "TH"
			},
			"source_name": {
				"type": "string",
				"defaultValue": "winapp"
			},
			"source_file_name": {
				"type": "array"
			}
		},
		"variables": {
			"landing_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "TH/WIN/BRONZE"
		},
		"annotations": []
	}
}
