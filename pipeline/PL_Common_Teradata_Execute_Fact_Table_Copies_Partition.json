{
	"name": "PL_Common_Teradata_Execute_Fact_Table_Copies_Partition",
	"properties": {
		"description": "Master pipeline Partial load for Teradata source tables",
		"activities": [
			{
				"name": "FOR_EACH_ENTRY",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_QUERY",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LKP_MAX_WATERMARK",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_QUERY').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Execute PL_Common_Teradata_Fact_Generic_Copy_Partial",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Teradata_Fact_Generic_Copy_Partial",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"TableName": {
										"value": "@pipeline().parameters.p_TableName",
										"type": "Expression"
									},
									"WatermarkStart": {
										"value": "@if(equals(toUpper(activity('FLTR_LKP_QUERY').output.value[0].ExtractionColumnDataType),'DATE'),split(item().lower_count,'T')[0],item().lower_count)",
										"type": "Expression"
									},
									"WatermarkEnd": {
										"value": "@if(equals(toUpper(activity('FLTR_LKP_QUERY').output.value[0].ExtractionColumnDataType),'DATE'),split(item().upper_count,'T')[0],item().upper_count)",
										"type": "Expression"
									},
									"FolderName": {
										"value": "@concat('full/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
										"type": "Expression"
									},
									"SourceSystem": {
										"value": "@pipeline().parameters.p_SourceSystem",
										"type": "Expression"
									},
									"DatabaseName": {
										"value": "@pipeline().parameters.p_DatabaseName",
										"type": "Expression"
									},
									"partitionval": {
										"value": "@if(contains(item(),'part_val'),item().part_val,'')",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "LKP_CONFIG_FILE",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_TeraData_CONFIG_PricingCompetitive_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "TERADATA_DB_CONFIGURATION_PRICING_COMPETITIVE.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_LKP_QUERY",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(and(equals(item().SourceSystem,pipeline().parameters.p_SourceSystem),equals(item().DatabaseName,pipeline().parameters.p_DatabaseName)),equals(item().SourceTableName,pipeline().parameters.p_TableName))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "LKP_QUERY",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "FLTR_LKP_QUERY",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "TeradataSource",
						"query": {
							"value": "@activity('FLTR_LKP_QUERY').output.value[0].ExtractionDerivation",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Teradata_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Execute PL_Common_Generic_Cleanse",
				"description": "Execute cleanse notebook pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "CREATE_POSTPROCESS_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Common_Generic_Cleanse",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tableName": {
							"value": "@pipeline().parameters.p_TableName",
							"type": "Expression"
						},
						"sourceSystem": {
							"value": "@pipeline().parameters.p_SourceSystem",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "LKP_MAX_WATERMARK",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "FLTR_LKP_QUERY",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "TeradataSource",
						"query": {
							"value": "select max(@{activity('FLTR_LKP_QUERY').output.value[0]['WatermarkColumnName']}) as max_updated_time from @{activity('FLTR_LKP_QUERY').output.value[0]['DatabaseName']}.@{activity('FLTR_LKP_QUERY').output.value[0]['SourceTableName']} where @{activity('FLTR_LKP_QUERY').output.value[0]['WhereClause']}",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Teradata_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "CREATE_POSTPROCESS_FILE",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "FOR_EACH_ENTRY",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "SRC_Name",
								"value": {
									"value": "@activity('FLTR_LKP_QUERY').output.value[0]['SourceSystem']",
									"type": "Expression"
								}
							},
							{
								"name": "SRC_Table",
								"value": {
									"value": "@activity('FLTR_LKP_QUERY').output.value[0]['SourceTableName']",
									"type": "Expression"
								}
							},
							{
								"name": "Watermark_Column",
								"value": {
									"value": "@activity('FLTR_LKP_QUERY').output.value[0]['WatermarkColumnName']",
									"type": "Expression"
								}
							},
							{
								"name": "Watermark_Value",
								"value": {
									"value": "@if(equals(activity('LKP_MAX_WATERMARK').output.firstRow.max_updated_time,null),null,\nformatDateTime(activity('LKP_MAX_WATERMARK').output.firstRow.max_updated_time,'yyyy-MM-ddTHH:mm:ss'))",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "SRC_Name",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Name"
								}
							},
							{
								"source": {
									"name": "SRC_Table",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Table"
								}
							},
							{
								"source": {
									"name": "Watermark_Column",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Column"
								}
							},
							{
								"source": {
									"name": "Watermark_Value",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Value"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_COMM_POSTPROCESS_CSV",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@activity('FLTR_LKP_QUERY').output.value[0]['SourceTableName']",
								"type": "Expression"
							},
							"domain": {
								"value": "@activity('FLTR_LKP_QUERY').output.value[0]['Domain']",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@activity('FLTR_LKP_QUERY').output.value[0]['SourceSystem']",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"p_SourceSystem": {
				"type": "string"
			},
			"p_DatabaseName": {
				"type": "string"
			},
			"p_TableName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Digital-Merchandising/TERADATA"
		},
		"annotations": [],
		"lastPublishTime": "2022-06-16T17:01:40Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}