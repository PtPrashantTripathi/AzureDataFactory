{
	"name": "PL_SEAID_A_ONBOARDER_LANDED",
	"properties": {
		"activities": [
			{
				"name": "AT_REPORT",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "AT_LOOP_Ingest_files",
						"dependencyConditions": [
							"Succeeded",
							"Failed",
							"Skipped"
						]
					},
					{
						"activity": "AT_LOOP_Ingest_files_SUCCESS",
						"dependencyConditions": [
							"Succeeded",
							"Failed",
							"Skipped"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('status'), 'SUCCESS')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "OnboarderFailed",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@activity('AT_ADB_Onboarding').output.runOutput.message",
									"type": "Expression"
								},
								"errorCode": "500"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "AT_FLTR_ERROR_ITEMS",
							"type": "Filter",
							"dependsOn": [
								{
									"activity": "AT_SET_ProcessedFiles",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@variables('processed_files')",
									"type": "Expression"
								},
								"condition": {
									"value": "@not(\n    and(\n        contains(item(), 'row_status_reason')\n        , equals(item().row_status_reason, 'SUCCESS')\n    )\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "PL_SEAID_A_ONBOARDER_ALERT",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "AT_FLTR_ERROR_ITEMS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SEAID_A_ONBOARDER_ALERT",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"is_alert": true,
									"invalid_records": {
										"value": "@activity('AT_FLTR_ERROR_ITEMS').output.Value",
										"type": "Expression"
									},
									"data_owner_email": {
										"value": "@activity('AT_ADB_Onboarding').output.runOutput.points_of_contact.data_owner",
										"type": "Expression"
									},
									"process_owner_email": {
										"value": "@activity('AT_ADB_Onboarding').output.runOutput.points_of_contact.process_owner",
										"type": "Expression"
									},
									"error_case": "ERROR_FILES",
									"data_source": {
										"value": "@pipeline().parameters.source_name",
										"type": "Expression"
									},
									"object_name": {
										"value": "@pipeline().parameters.object_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "AT_SET_ProcessedFiles",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "processed_files",
								"value": {
									"value": "@if(\n    contains(\n        activity('AT_ADB_Onboarding').output.runOutput\n        , 'extraction_result'\n    )\n    , activity('AT_ADB_Onboarding').output.runOutput.extraction_result\n    , variables('processed_file_names')\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "AT_SET_Processing-Directory",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "processing_directory",
					"value": {
						"value": "@concat(pipeline().parameters.source_container, '/', pipeline().parameters.source_directory)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "AT_LOOP_processing_file_names",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "AT_SET_Processing-Directory",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.source_file_name",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "AT_SET_Processing-File-Path",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "processing_file_name",
								"value": {
									"value": "@concat(formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMddHHmmss'),'-',item())",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_APPEND_Processed_file_names",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "AT_isParquet_format",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "processed_file_names",
								"value": {
									"value": "@concat('processing/',variables('processing_directory'),'/',variables('processing_file_name'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_isParquet_format",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "AT_SET_Processing-File-Path",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@contains(item(),'.parquet')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "AT_CPY_Processing_Else",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobStorageReadSettings",
													"recursive": false,
													"deleteFilesAfterCompletion": true
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_BINARY",
												"type": "DatasetReference",
												"parameters": {
													"container": {
														"value": "@pipeline().parameters.source_container",
														"type": "Expression"
													},
													"directory": {
														"value": "@pipeline().parameters.source_directory",
														"type": "Expression"
													},
													"file_name": "@item()"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_BINARY",
												"type": "DatasetReference",
												"parameters": {
													"container": "processing",
													"directory": {
														"value": "@variables('processing_directory')",
														"type": "Expression"
													},
													"file_name": {
														"value": "@variables('processing_file_name')",
														"type": "Expression"
													}
												}
											}
										]
									}
								],
								"ifTrueActivities": [
									{
										"name": "AT_CPY_Processing_Parquet",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "ParquetSource",
												"storeSettings": {
													"type": "AzureBlobStorageReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "ParquetReadSettings"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_ABLB_PARQUET",
												"type": "DatasetReference",
												"parameters": {
													"container": {
														"value": "@pipeline().parameters.source_container",
														"type": "Expression"
													},
													"directory": {
														"value": "@pipeline().parameters.source_directory",
														"type": "Expression"
													},
													"file_name": "@item()"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ABLB_PARQUET",
												"type": "DatasetReference",
												"parameters": {
													"container": "processing",
													"directory": {
														"value": "@variables('processing_directory')",
														"type": "Expression"
													},
													"file_name": {
														"value": "@variables('processing_file_name')",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "AT_DEL_Landing_parquet",
										"type": "Delete",
										"dependsOn": [
											{
												"activity": "AT_CPY_Processing_Parquet",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_ABLB_PARQUET",
												"type": "DatasetReference",
												"parameters": {
													"container": {
														"value": "@pipeline().parameters.source_container",
														"type": "Expression"
													},
													"directory": {
														"value": "@pipeline().parameters.source_directory",
														"type": "Expression"
													},
													"file_name": "@item()"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": false,
												"enablePartitionDiscovery": false
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "AT_LOOP_Ingest_files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "AT_SET_Status-UnexpectedError",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('processed_file_names')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "AT_SET_Archival-FileName",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "AT_SET_SplitFilePath",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "archival_file_name",
								"value": {
									"value": "@concat(variables('status'), '_', last(variables('file_name_part')))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_CPY_Archival_Binary",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "AT_SET_Archival-FileName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"deleteFilesAfterCompletion": true
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_BINARY",
									"type": "DatasetReference",
									"parameters": {
										"container": {
											"value": "processing",
											"type": "Expression"
										},
										"directory": {
											"value": "@variables('processing_directory')",
											"type": "Expression"
										},
										"file_name": {
											"value": "@last(variables('file_name_part'))",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_BINARY",
									"type": "DatasetReference",
									"parameters": {
										"container": "archival",
										"directory": {
											"value": "@variables('processing_directory')",
											"type": "Expression"
										},
										"file_name": {
											"value": "@variables('archival_file_name')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "AT_TERMINATE_Fail_Copy_Archival",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "AT_CPY_Archival_Binary",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@activity('AT_ADB_Onboarding').output.runOutput.message",
									"type": "Expression"
								},
								"errorCode": {
									"value": "@concat('500 - Onboarder: ', activity('AT_ADB_Onboarding').output.runOutput.status, activity('AT_ADB_Onboarding').output.runOutput.message, ' - Archival: Copy Failed!')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_SET_SplitFilePath",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "file_name_part",
								"value": {
									"value": "@split(item(), '/')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "AT_ADB_Onboarding",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "AT_LOOP_processing_file_names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@pipeline().parameters.onboarder_notebook_path",
						"type": "Expression"
					},
					"baseParameters": {
						"landing_path": {
							"value": "@string(variables('processed_file_names'))",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"object_type": {
							"value": "@pipeline().parameters.object_type",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@pipeline().parameters.landing_date",
							"type": "Expression"
						},
						"save_mode": {
							"value": "@pipeline().parameters.save_mode",
							"type": "Expression"
						},
						"time_zone": "utc",
						"partition_keys": {
							"value": "@pipeline().parameters.partition_keys",
							"type": "Expression"
						},
						"sequential_extraction": {
							"value": "@pipeline().parameters.sequential_extraction",
							"type": "Expression"
						},
						"job_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"metastore": {
							"value": "@pipeline().parameters.metastore",
							"type": "Expression"
						},
						"cache_level": {
							"value": "@pipeline().parameters.cache_level",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_ADB",
					"type": "LinkedServiceReference",
					"parameters": {
						"ADBCountryCode": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"InitScriptPath": "/Shared/utilities/scripts/initial_script_databricks_cluster_v2.sh",
						"UniframeVersion": {
							"value": "@pipeline().parameters.uniframe_version",
							"type": "Expression"
						},
						"RuntimeVersion": {
							"value": "@pipeline().parameters.adb_runtime_version",
							"type": "Expression"
						},
						"MinWorkers": 1,
						"MaxWorkers": 10
					}
				}
			},
			{
				"name": "AT_SET_Status-Result",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "AT_ADB_Onboarding",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "status",
					"value": {
						"value": "@activity('AT_ADB_Onboarding').output.runOutput.status",
						"type": "Expression"
					}
				}
			},
			{
				"name": "AT_SET_Status-UnexpectedError",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "AT_ADB_Onboarding",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "status",
					"value": "ERROR"
				}
			},
			{
				"name": "AT_LOOP_Ingest_files_SUCCESS",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "AT_SET_Status-Result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@if(\n    and(\n        contains(\n            activity('AT_ADB_Onboarding').output.runOutput,'extraction_result'\n        )\n        , greater(\n            length(\n                activity('AT_ADB_Onboarding').output.runOutput.extraction_result\n            )\n            , 0\n        )\n    ), \n    activity('AT_ADB_Onboarding').output.runOutput.extraction_result\n    , variables('processed_file_names')\n)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "AT_SET_Archival-ExtractedFileName",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "AT_SET_FileStatus",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "archival_file_name",
								"value": {
									"value": "@concat(variables('file_status'), '_', variables('processed_file_name'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_CPY_Archival_ExtractedBinary",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "AT_SET_Archival-ExtractedFileName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"deleteFilesAfterCompletion": true
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_BINARY",
									"type": "DatasetReference",
									"parameters": {
										"container": {
											"value": "processing",
											"type": "Expression"
										},
										"directory": {
											"value": "@variables('processing_directory')",
											"type": "Expression"
										},
										"file_name": {
											"value": "@variables('processed_file_name')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_BINARY",
									"type": "DatasetReference",
									"parameters": {
										"container": "archival",
										"directory": {
											"value": "@variables('processing_directory')",
											"type": "Expression"
										},
										"file_name": {
											"value": "@variables('archival_file_name')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "AT_TERMINATE_Fail_Copy_ExtractedArchival",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "AT_CPY_Archival_ExtractedBinary",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@activity('AT_ADB_Onboarding').output.runOutput.message",
									"type": "Expression"
								},
								"errorCode": {
									"value": "@concat('500 - Onboarder: ', activity('AT_ADB_Onboarding').output.runOutput.status, activity('AT_ADB_Onboarding').output.runOutput.message, ' - Archival: Copy Failed!')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_SET_FileStatus",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "AT_SET_FileName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "file_status",
								"value": {
									"value": "@if(\n    and(\n        contains(item(),'row_status_reason')\n        , equals(item().row_status_reason, 'SUCCESS')\n    )\n    , 'SUCCESS'\n    , activity('AT_ADB_Onboarding').output.runOutput.status\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AT_SET_FileName",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "processed_file_name",
								"value": {
									"value": "@if(\n    contains(item(), 'file_name')\n    , item().file_name\n    , last(\n        array(split(item(), '/'))\n    )\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
