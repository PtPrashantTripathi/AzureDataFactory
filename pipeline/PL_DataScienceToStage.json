{
	"name": "PL_DataScienceToStage",
	"properties": {
		"description": "Copy data from Data Science container to Stage",
		"activities": [
			{
				"name": "LKP_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_TeraData_CONFIG_Promo_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "DATASCIENCE_CONTAINER_CONFIGURATION.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_SRC",
				"description": "",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().Domain,pipeline().parameters.p_Domain)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FOREACH_SRC_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLTR_SRC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLTR_SRC').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "PL_DataScience_Output_Generic_Copy",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_DataScience_Output_Generic_Copy",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"dataScienceContainerPath": {
										"value": "@item().DataScienceContainerPath",
										"type": "Expression"
									},
									"stagedContainerPath": {
										"value": "@item().StagedContainerPath",
										"type": "Expression"
									},
									"logTable": {
										"value": "@item().LogTable",
										"type": "Expression"
									},
									"logTablePath": {
										"value": "@item().LogTablePath",
										"type": "Expression"
									},
									"eventFilePath": {
										"value": "@item().EventFilePath",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_Domain": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/DSOutputGenericCopy"
		},
		"annotations": []
	}
}
