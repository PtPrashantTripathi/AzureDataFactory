{
	"name": "PL_VN_M_DT_DIM_DISPLAY_TYPE_SILVER_MASTER",
	"properties": {
		"activities": [
			{
				"name": "PL_SEAID_A_ONBOARDER_STAGE_BUILDER",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_STAGE_BUILDER",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"write_mode": "overwrite",
						"onboarder_notebook_path": {
							"value": "@pipeline().parameters.notebook_path",
							"type": "Expression"
						},
						"partition_keys": {
							"value": "@pipeline().parameters.partition_keys",
							"type": "Expression"
						},
						"on_error_alert": true,
						"layer": "Silver",
						"stage": "Dimension",
						"number_of_days_look_back": "0",
						"uniframe_version": "3.*",
						"adb_runtime_version": "14.3.x-scala2.12"
					}
				}
			},
			{
				"name": "AT_SET_LandingDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "landing_date",
					"value": {
						"value": "@formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"time_zone": {
				"type": "string",
				"defaultValue": "SE Asia Standard Time"
			},
			"country_code": {
				"type": "string",
				"defaultValue": "VN"
			},
			"object_name": {
				"type": "string",
				"defaultValue": "dim_display_type"
			},
			"source_name": {
				"type": "string",
				"defaultValue": "DistributiveTrade"
			},
			"partition_keys": {
				"type": "string",
				"defaultValue": "country"
			},
			"notebook_path": {
				"type": "string",
				"defaultValue": "/Shared/notebooks/silver/DistributiveTrade/VN_DT_DIM_DISPLAY_TYPE"
			}
		},
		"variables": {
			"landing_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "VN/DISTRIBUTIVE_TRADE"
		},
		"annotations": []
	}
}
