						},
						"write_mode": {
							"value": "@pipeline().parameters.write_mode",
							"type": "Expression"
						},
						"uniframe_version": {
							"value": "@pipeline().parameters.uniframe_version",
							"type": "Expression"
						},
						"adb_runtime_version": "14.3.x-scala2.12",
						"metastore": {
							"value": "@pipeline().parameters.metastore",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"source_directory": {
				"type": "string"
			},
			"source_container": {
				"type": "string"
			},
			"object_name": {
				"type": "string"
			},
			"object_type": {
				"type": "string",
				"defaultValue": "parquet"
			},
			"primary_keys": {
				"type": "string"
			},
			"partition_keys": {
