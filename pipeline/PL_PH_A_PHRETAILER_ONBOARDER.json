							"value": "@pipeline().parameters.metastore",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "EXE_Onboarder-Processed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "EXE_Onboarder-Landed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_PROCESSED",
