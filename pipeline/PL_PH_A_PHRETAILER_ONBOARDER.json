			},
			"source_name": {
				"type": "string"
			},
			"source_file_name": {
				"type": "string"
			},
			"save_mode": {
				"type": "string"
			},
			"write_mode": {
				"type": "string"
			},
			"custom_notebook_path": {
				"type": "string"
			},
			"master_pipeline": {
				"type": "string"
			},
			"uniframe_version": {
				"type": "string",
				"defaultValue": "3.*"
			},
			"metastore": {
				"type": "string",
				"defaultValue": "hive"
			}
		},
		"variables": {
			"landing_date": {
				"type": "String"
			},
			"source": {
				"type": "String"
			}
		},
		"folder": {
			"name": "PH/child_pipelines"
		},
		"annotations": []
	}
}
