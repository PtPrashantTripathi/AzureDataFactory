{
	"name": "PL_PH_A_PHRETAILER_ONBOARDER",
	"properties": {
		"activities": [
			{
				"name": "AT_SET_LandingDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "landing_date",
					"value": {
						"value": "@formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EXE_Onboarder-Landed",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_PH_SEAID_A_ONBOARDER_LANDED",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_container": {
							"value": "@pipeline().parameters.source_container",
							"type": "Expression"
						},
						"source_directory": {
							"value": "@pipeline().parameters.source_directory",
							"type": "Expression"
						},
						"source_file_name": {
							"value": "@pipeline().parameters.source_file_name",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"object_type": {
							"value": "@pipeline().parameters.object_type",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"onboarder_notebook_path": {
							"value": "@pipeline().parameters.custom_notebook_path",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"save_mode": {
							"value": "@pipeline().parameters.save_mode",
							"type": "Expression"
						},
						"master_pipeline": {
							"value": "@pipeline().parameters.master_pipeline",
							"type": "Expression"
						},
						"uniframe_version": {
							"value": "@pipeline().parameters.uniframe_version",
							"type": "Expression"
						},
						"adb_runtime_version": "14.3.x-scala2.12",
