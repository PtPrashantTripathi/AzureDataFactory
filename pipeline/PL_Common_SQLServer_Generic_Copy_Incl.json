								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"fileName": "@concat(pipeline().parameters.tableName,'_audit_',formatDateTime(utcnow()) )"
						}
					}
				]
			},
			{
				"name": "DELETE_FILE_FROM_ADLS",
				"description": "Delete SQLServer Data from Data Lake if update postprocess fails",
				"type": "Delete",
