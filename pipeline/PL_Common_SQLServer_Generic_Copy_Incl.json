									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Name"
								}
							},
							{
								"source": {
									"name": "Pipeline_Runid",
									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Runid"
								}
							},
							{
								"source": {
									"name": "Pipeline_Runtime_UTC",
									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Runtime_UTC"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_COMM_AUDIT_CSV",
						"type": "DatasetReference",
						"parameters": {
							"sourceSystem": {
