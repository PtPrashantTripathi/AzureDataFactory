								},
								"sink": {
									"name": "SRC_Name"
								}
							},
							{
								"source": {
									"name": "SRC_Table",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Table"
								}
							},
							{
								"source": {
									"name": "Watermark_Column",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Column"
								}
							},
							{
								"source": {
									"name": "Watermark_Value",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Value"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_POSTPROCESS_CSV",
						"type": "DatasetReference",
						"parameters": {
							"tableName": "@pipeline().parameters.tableName",
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_COMM_PREPROCESS_CSV",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LKP_GET_PREV_MAXDATE",
