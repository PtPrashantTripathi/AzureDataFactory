{
	"name": "PL_Common_SQLServer_Generic_Copy_Incl",
	"properties": {
		"description": "Generic Copy pipeline Incremental load for PMM (Sqlserver) and DRAdmin",
		"activities": [
			{
				"name": "COPY_SRC_SQL_DATA_TO_ADLS",
				"description": "Copy Generic SQLServer Data to Data Lake",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LKP_GET_MAXDATE",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LKP_GET_PREV_MAXDATE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM [dbo].[@{pipeline().parameters.tableName}] WITH(NOLOCK) where @{pipeline().parameters.watermarkColumnName} > cast(CONVERT(datetime2, concat(substring('@{activity('LKP_GET_PREV_MAXDATE').output.firstRow.Watermark_Value}',1,19),'.',substring('@{activity('LKP_GET_PREV_MAXDATE').output.firstRow.Watermark_Value}' ,21,26)),101) as datetime) and @{pipeline().parameters.watermarkColumnName} <='@{activity('LKP_GET_MAXDATE').output.firstRow.max_updated_time}' \n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"parallelCopies": 10
				},
				"inputs": [
					{
						"referenceName": "DS_SQLServer_Generic",
						"type": "DatasetReference",
						"parameters": {
							"ds_ServerInstance": {
								"value": "@pipeline().parameters.serverInstance",
								"type": "Expression"
							},
							"ds_DatabaseName": {
								"value": "@pipeline().parameters.databaseName",
								"type": "Expression"
							},
							"ds_UserName": {
								"value": "@pipeline().parameters.userName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SINK_Generic_csv",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@pipeline().parameters.fileName",
								"type": "Expression"
							},
							"folderName": {
								"value": "@pipeline().parameters.folderName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LKP_GET_MAXDATE",
				"description": "Get the latest max watermark date from database",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT max(@{pipeline().parameters.watermarkColumnName}) as max_updated_time FROM [dbo].[@{pipeline().parameters.tableName}] WITH(NOLOCK)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQLServer_Generic",
						"type": "DatasetReference",
						"parameters": {
							"ds_ServerInstance": {
								"value": "@pipeline().parameters.serverInstance",
								"type": "Expression"
							},
							"ds_DatabaseName": {
								"value": "@pipeline().parameters.databaseName",
								"type": "Expression"
							},
							"ds_UserName": {
								"value": "@pipeline().parameters.userName",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "UPDATE_PREPROCESS_FILE",
