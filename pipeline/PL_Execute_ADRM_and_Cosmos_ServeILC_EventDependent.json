{
	"name": "PL_Execute_ADRM_and_Cosmos_ServeILC_EventDependent",
	"properties": {
		"activities": [
			{
				"name": "LKP_GET_MAXORDER",
				"description": "Get the maximum order value from the log table",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Delete Previous Event File",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureDatabricksDeltaLakeSource",
						"query": {
							"value": "select max(orderExec) as max_order from logadrmexecproduct where levelExec = @{pipeline().parameters.level}",
							"type": "Expression"
						}
					},
					"dataset": {
						"referenceName": "DS_AzureDatabricksDeltaLakeDataset",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Until1",
				"description": "Until loop executes one order at a time",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "SET_INITIAL_ORDER_VALUE",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set variable Timestamp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(int(variables('count_order')),int(activity('LKP_GET_MAXORDER').output.firstRow.max_order))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "SET_SUB_VALUE",
							"description": "Set the sub value to hold the increment of the original count value",
							"type": "SetVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sub",
								"value": {
									"value": "@string(add(int(variables('count_order')),1))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_COUNT_ORDER_VALUE",
							"description": "set the count value to the incremented value of itself",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "SET_SUB_VALUE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "count_order",
								"value": {
									"value": "@variables('sub')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "EXEC_PL_Generic_DataLoad",
							"description": "Execute the generic pipeline for the corresponding level and order",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "SET_COUNT_ORDER_VALUE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_ADRM_Generic_DataLoad_ILC",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"level": {
										"value": "@pipeline().parameters.level",
										"type": "Expression"
									},
									"fullorincl": {
										"value": "@pipeline().parameters.fullorincl",
										"type": "Expression"
									},
									"order": {
										"value": "@sub(int(variables('count_order')),1)",
										"type": "Expression"
									},
									"start_Timestamp": {
										"value": "@variables('start_Timestamp')",
										"type": "Expression"
									}
								}
							}
						}
					],
					"timeout": "7.00:00:00"
				}
			},
			{
				"name": "SET_INITIAL_ORDER_VALUE",
				"description": "Set the initial value of order to 1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LKP_GET_MAXORDER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "count_order",
					"value": "1"
				}
			},
			{
				"name": "Execute PL_Export_To_Cosmos for ILC collection",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Until1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Export_To_Cosmos_ILC",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"collectionname": "ILCLocationLevel",
						"fullorincl": {
							"value": "@pipeline().parameters.cosmos_load",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute PL_Export_To_Cosmos for ILCZone collection",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Until1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Export_To_Cosmos_ILC",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"collectionname": "ILCZone",
						"fullorincl": {
							"value": "@pipeline().parameters.cosmos_load",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set variable Timestamp",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Delete Previous Event File",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_Timestamp",
					"value": {
						"value": "@utcnow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute PL_Export_To_Cosmos for ILCFixture collection",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Export_To_Cosmos for ILCZone collection",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Export_To_Cosmos_ILC",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"collectionname": "ILCFixture",
						"fullorincl": {
							"value": "@pipeline().parameters.cosmos_load",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Generate Event for Collection run Completion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Execute PL_Export_To_Cosmos for ILC collection",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Execute PL_Export_To_Cosmos for ILCFixture collection",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "ILC_Event_Collection_Completion.blob"
						}
					}
				]
			},
			{
				"name": "Check if the Completed file is present",
				"type": "Validation",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "ILC_Event_Collection_Completion.blob"
						}
					},
					"timeout": "0.00:05:00",
					"sleep": 10
				}
			},
			{
				"name": "Delete Previous Event File",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Check if the Completed file is present",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 30,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "ILC_Event_Collection_Completion.blob"
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"fullorincl": {
				"type": "string"
			},
			"level": {
				"type": "string",
				"defaultValue": "-3"
			},
			"cosmos_load": {
				"type": "string"
			}
		},
		"variables": {
			"count_order": {
				"type": "String"
			},
			"sub": {
				"type": "String"
			},
			"start_Timestamp": {
				"type": "String"
			}
		},
		"folder": {
			"name": "ProductAPI/ILC"
		},
		"annotations": [],
		"lastPublishTime": "2021-03-01T09:17:14Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
