{
	"name": "PL_PH_A_ONBOARDER_COMMON_SILVER",
	"properties": {
		"activities": [
			{
				"name": "AT_ADB_Silver_Layer_Onboarding",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Timestamp Validation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "1.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "@pipeline().parameters.silver_notebook_path",
					"baseParameters": {
						"entity_name": {
							"value": "@pipeline().parameters.entity_name",
							"type": "Expression"
						},
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"source_object": {
							"value": "@pipeline().parameters.source_object",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"full_or_incl": {
							"value": "@pipeline().parameters.full_or_incl",
							"type": "Expression"
						},
						"adhoc_ts": {
							"value": "@variables('adhoc_ts')",
							"type": "Expression"
						},
						"metastore": {
							"value": "@pipeline().parameters.metastore",
							"type": "Expression"
						},
						"environment": {
							"value": "@pipeline().globalParameters.ENVIRONMENT",
							"type": "Expression"
						}
					},
					"libraries": [
						{
							"jar": "dbfs:/mnt/databricks/jars/uniframe/deequ-2.0.1-spark-3.2.jar"
						},
						{
							"maven": {
								"coordinates": "com.crealytics:spark-excel_2.12:3.2.1_0.17.1"
							}
						}
					]
				},
				"linkedServiceName": {
					"referenceName": "LS_ADB",
					"type": "LinkedServiceReference",
					"parameters": {
						"ADBCountryCode": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"InitScriptPath": "/Shared/utilities/scripts/initial_script_databricks_cluster_v2.sh",
						"UniframeVersion": {
							"value": "@pipeline().parameters.uniframe_version",
							"type": "Expression"
						},
						"RuntimeVersion": {
							"value": "@pipeline().parameters.adb_runtime_version",
							"type": "Expression"
						},
						"MinWorkers": 1,
						"MaxWorkers": 10
					}
				}
			},
			{
				"name": "AT_WEB_EMAIL_PROCEESSING_FAIL",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "AT_ADB_Silver_Layer_Onboarding",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@pipeline().globalParameters.PH_MDL_LOGICAPPS_02",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"Logic Apps Case\" : \"Email Alert\",\n    \"subject\":\"@{pipeline().globalParameters.ENVIRONMENT} - Silver Layer Proccessing Failed - @{pipeline().parameters.entity_name}\",\n    \"to\":\"@{variables('receiver')}\",\n    \"Return Code\":\"@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.return_code}\",\n    \"body\": \"@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.message}\",\n    \"run_id\":\"@{pipeline().RunId}\",\n    \"run_date_time\":\"@{formatDateTime(utcNow(),'dd/MM/yyyy')}\",\n    \"out_df\":@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.out_df},\n    \"triggered_pipeline\":\"@{pipeline().Pipeline}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FAIL",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "AT_WEB_EMAIL_PROCEESSING_FAIL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('AT_ADB_Silver_Layer_Onboarding').output",
						"type": "Expression"
					},
					"errorCode": "200"
				}
			},
			{
				"name": "Timestamp Validation",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(empty(pipeline().parameters.adhoc_ts))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set Timestamp Variable",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adhoc_ts",
								"value": {
									"value": "@formatDateTime(pipeline().parameters.adhoc_ts,'yyyy-MM-dd hh:mm:ss')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Timestamp Validation Failure",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Set Timestamp Variable",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Timestamp Validation Failed",
								"errorCode": "Failed"
							}
						}
					]
				}
			},
			{
				"name": "ForEach",
				"description": "Run loop for PBI Dataflow ID",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.pbi_dataflow_id_list",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "AT_WEB_LA_POWERBI_DATAFLOW_REFRESH",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": {
									"value": "@pipeline().globalParameters.PH_MDL_POWERAPP_DATAFLOW_URL",
									"type": "Expression"
								},
								"body": {
									"value": "{   \n    \"environment\" : \"@{pipeline().globalParameters.ENVIRONMENT}\",\n    \"pbi_dataflow\" : \"@{item()}\",\n    \"pbi_workspace\" : \"02967bfe-d98d-4939-97a9-041eca1703e2\"\n}",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Send Email if error",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "AT_ADB_Silver_Layer_Onboarding",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(int(activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.error_count),0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "AT_WEB_EMAIL_PROCEESSING_SUCCESS",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": {
									"value": "@pipeline().globalParameters.PH_MDL_LOGICAPPS_02",
									"type": "Expression"
								},
								"body": {
									"value": "{\n    \"Logic Apps Case\" : \"Email Validation Success\", \n    \"subject\":\"@{pipeline().globalParameters.ENVIRONMENT} - Silver Layer Proccessing Completed - @{pipeline().parameters.entity_name}\",\n    \"to\":\"@{variables('receiver')}\",\n    \"Return Code\":\"@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.return_code}\",\n    \"body\": \"@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.message}\",\n    \"run_id\":\"@{pipeline().RunId}\",\n    \"run_date_time\":\"@{formatDateTime(utcNow(),'dd/MM/yyyy')}\",\n    \"out_df\":@{activity('AT_ADB_Silver_Layer_Onboarding').output.runOutput.out_df},\n    \"triggered_pipeline\":\"@{pipeline().Pipeline}\"\n}",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"entity_name": {
				"type": "string",
				"defaultValue": "ALL"
			},
			"source_name": {
				"type": "string",
				"defaultValue": "ALL"
			},
			"source_object": {
				"type": "string",
				"defaultValue": "ALL"
			},
			"country_code": {
				"type": "string",
				"defaultValue": "PH"
			},
			"full_or_incl": {
				"type": "string",
				"defaultValue": "INCL"
			},
			"adhoc_ts": {
				"type": "string"
			},
			"uniframe_version": {
				"type": "string",
				"defaultValue": "3.*"
			},
			"adb_runtime_version": {
				"type": "string",
				"defaultValue": "14.3.x-scala2.12"
			},
			"metastore": {
				"type": "string",
				"defaultValue": "hive"
			},
			"silver_notebook_path": {
				"type": "string",
				"defaultValue": "/Shared/notebooks/silver/PH_MDL_COMMON/PH_MDL_COMMON_MASTER"
			}
		},
		"variables": {
			"adhoc_ts": {
				"type": "String"
			},
			"receiver": {
				"type": "String",
				"defaultValue": "ph_mdl@unilever.onmicrosoft.com"
			}
		},
		"folder": {
			"name": "PH/SILVER_LAYER"
		},
		"annotations": [],
		"lastPublishTime": "2024-06-20T03:39:53Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
