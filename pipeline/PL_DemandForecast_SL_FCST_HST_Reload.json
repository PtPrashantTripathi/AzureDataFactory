{
	"name": "PL_DemandForecast_SL_FCST_HST_Reload",
	"properties": {
		"activities": [
			{
				"name": "COPY_SRC_TERADATA_TO_ADLS_copy2",
				"description": "Copy Generic TeraData to Data Lake",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "TeradataSource",
						"query": {
							"value": "select * from @{pipeline().parameters.Database}.@{pipeline().parameters.TableName} where DAY_DT BETWEEN @{pipeline().parameters.StartDate} AND @{pipeline().parameters.EndDate}",
							"type": "Expression"
						},
						"partitionOption": "Hash",
						"partitionSettings": {
							"partitionColumnName": {
								"value": "DAY_DT",
								"type": "Expression"
							}
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"parallelCopies": 10,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Teradata_Generic",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_GENERIC_COPY_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "data.csv",
								"type": "Expression"
							},
							"folderPath": {
								"value": "data/@{pipeline().parameters.SourceSystem}/@{pipeline().parameters.SourceSystem}/@{pipeline().parameters.TableName}/Reload",
								"type": "Expression"
							},
							"fileSystem": "raw"
						}
					}
				]
			},
			{
				"name": "DF SL_FCST_HST fix",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "COPY_SRC_TERADATA_TO_ADLS_copy2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Pos/PosAPI/GRC/DemandForecast/DF_dly_ut_p_anlt_sl_fcst_hst_data_fix"
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"Database": {
				"type": "string",
				"defaultValue": "VPROD_MDS_RPLNM"
			},
			"TableName": {
				"type": "string",
				"defaultValue": "DLY_UT_P_ANLT_SL_FCST_HST"
			},
			"StartDate": {
				"type": "string"
			},
			"EndDate": {
				"type": "string"
			},
			"SourceSystem": {
				"type": "string",
				"defaultValue": "DemandForecast"
			}
		},
		"folder": {
			"name": "PosAPI/Datastage"
		},
		"annotations": []
	}
}