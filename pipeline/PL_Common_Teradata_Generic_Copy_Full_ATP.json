{
	"name": "PL_Common_Teradata_Generic_Copy_Full_ATP",
	"properties": {
		"description": "Generic pipeline Incremental load for Teradata source tables",
		"activities": [
			{
				"name": "Databricks Notebook for cleansing",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "CREATE_AUDIT_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published/DATA/CLEANSE/getRawFiles",
					"baseParameters": {
						"tableName": {
							"value": "@pipeline().parameters.tableName",
							"type": "Expression"
						},
						"fileName": {
							"value": "@concat(pipeline().parameters.fileName,'.csv')",
							"type": "Expression"
						},
						"filePath": {
							"value": "@concat('data/',pipeline().parameters.domain,'/',pipeline().parameters.sourceSystem,'/',pipeline().parameters.tableName,'/',pipeline().parameters.folderName,'/')",
							"type": "Expression"
						},
						"timestampIngested": {
							"value": "@utcnow()",
							"type": "Expression"
						},
						"rowsCopied": {
							"value": "@string(activity('COPY_SRC_TERADATA_TO_ADLS').output.rowsCopied)",
							"type": "Expression"
						},
						"sourceSystem": {
							"value": "@pipeline().parameters.sourceSystem",
							"type": "Expression"
						},
						"domain": {
							"value": "@pipeline().parameters.domain",
							"type": "Expression"
						},
						"Watermark_Value": {
							"value": "@utcnow()",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_DS3",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "COPY_SRC_TERADATA_TO_ADLS",
				"description": "Copy Generic SQLServer Data to Data Lake",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "FLTR_Columns",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "TeradataSource",
						"query": {
							"value": "SELECT @{activity('FLTR_Columns').output.value[0].QueryColumns} FROM @{pipeline().parameters.databaseName}.@{pipeline().parameters.tableName} where ?AdfHashPartitionCondition ",
							"type": "Expression"
						},
						"partitionOption": "Hash",
						"partitionSettings": {
							"partitionColumnName": {
								"value": "@{pipeline().parameters.partitionColumn}",
								"type": "Expression"
							}
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"parallelCopies": 20
				},
				"inputs": [
					{
						"referenceName": "DS_Teradata_Generic",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SINK_Generic_csv",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@pipeline().parameters.fileName",
								"type": "Expression"
							},
							"folderName": {
								"value": "@pipeline().parameters.FolderName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "CREATE_AUDIT_FILE",
				"description": "Create audit file into Datalake",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "COPY_SRC_TERADATA_TO_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "Watermark_Value_Latest",
								"value": {
									"value": "@{formatDateTime(utcnow(),'yyyy-MM-ddTHH:mm:ss:ffffff')}",
									"type": "Expression"
								}
							},
							{
								"name": "Pipeline_Name",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							{
								"name": "Pipeline_Runid",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							{
								"name": "Rows_Copied",
								"value": {
									"value": "@activity('COPY_SRC_TERADATA_TO_ADLS').output.rowsCopied",
									"type": "Expression"
								}
							},
							{
								"name": "Pipeline_Runtime_UTC",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							},
							{
								"name": "SRC_Name",
								"value": {
									"value": "@pipeline().parameters.sourceSystem",
									"type": "Expression"
								}
							},
							{
								"name": "SRC_Table",
								"value": {
									"value": "@pipeline().parameters.tableName",
									"type": "Expression"
								}
							},
							{
								"name": "Watermark_Column",
								"value": {
									"value": "@{formatDateTime(utcnow(),'yyyy-MM-ddTHH:mm:ss:ffffff')}",
									"type": "Expression"
								}
							},
							{
								"name": "Rows_Read",
								"value": {
									"value": "@activity('COPY_SRC_TERADATA_TO_ADLS').output.rowsRead",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "SRC_Name",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Name"
								}
							},
							{
								"source": {
									"name": "SRC_Table",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Table"
								}
							},
							{
								"source": {
									"name": "Watermark_Column",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Column"
								}
							},
							{
								"source": {
									"name": "Watermark_Value_Latest",
									"type": "String"
								},
								"sink": {
									"name": "Watermark_Value_Latest"
								}
							},
							{
								"source": {
									"name": "Rows_Read",
									"type": "String"
								},
								"sink": {
									"name": "Rows_Read"
								}
							},
							{
								"source": {
									"name": "Rows_Copied",
									"type": "String"
								},
								"sink": {
									"name": "Rows_Copied"
								}
							},
							{
								"source": {
									"name": "Pipeline_Name",
									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Name"
								}
							},
							{
								"source": {
									"name": "Pipeline_Runid",
									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Runid"
								}
							},
							{
								"source": {
									"name": "Pipeline_Runtime_UTC",
									"type": "String"
								},
								"sink": {
									"name": "Pipeline_Runtime_UTC"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_COMM_AUDIT_CSV",
						"type": "DatasetReference",
						"parameters": {
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.fileName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LKP_DataScience_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_DataScience_Config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_Columns",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_DataScience_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_DataScience_Config').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().TableName,pipeline().parameters.tableName)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"sourceSystem": {
				"type": "string"
			},
			"domain": {
				"type": "string"
			},
			"folderName": {
				"type": "string"
			},
			"fileName": {
				"type": "string"
			},
			"databaseName": {
				"type": "string"
			},
			"partitionColumn": {
				"type": "string"
			}
		},
		"folder": {
			"name": "PosAPI/StoreItem"
		},
		"annotations": []
	}
}