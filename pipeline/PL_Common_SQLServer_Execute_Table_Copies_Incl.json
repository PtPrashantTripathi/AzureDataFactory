{
	"name": "PL_Common_SQLServer_Execute_Table_Copies_Incl",
	"properties": {
		"description": "Master pipeline Full load for Teradata source tables",
		"activities": [
			{
				"name": "LKP_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_SQL_CONFIG_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "SQLSERVER_DB_CONFIGURATION.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_SRC",
				"description": "",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@or(and(and(equals(pipeline().parameters.p_SourceSystem,'PosPromo'),equals(item().SourceSystem,pipeline().parameters.p_SourceSystem)),equals(item().DatabaseName,pipeline().parameters.p_DatabaseName)), and(and(and(equals(pipeline().parameters.p_SourceSystem, 'PosPromo'),equals(item().SourceSystem,pipeline().parameters.p_SourceSystem)),not(equals(item().SourceTableName,'dgtl_cpn_ofr_hub'))),not(equals(item().SourceTableName,'dgtl_cpn_trm_cdtn'))))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FOREACH_SRC_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLTR_SRC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLTR_SRC').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Execute PL_Common_Generic_Cleanse",
							"description": "Execute cleanse notebook pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute PL_SRC_Teradata_Generic_Copy_Full",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Generic_Cleanse",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute PL_SRC_Teradata_Generic_Copy_Full",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_SQLServer_Generic_Copy_Incl",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tableName": {
										"value": "@item().SourceTableName",
										"type": "Expression"
									},
									"databaseName": {
										"value": "@item().DatabaseName",
										"type": "Expression"
									},
									"serverInstance": {
										"value": "@item().ServerInstance",
										"type": "Expression"
									},
									"domain": {
										"value": "@item().Domain",
										"type": "Expression"
									},
									"sourceSystem": {
										"value": "@item().SourceSystem",
										"type": "Expression"
									},
									"folderName": {
										"value": "@concat('full/','Year=',formatDateTime(utcnow(),'yyyy'),'/','Month=',formatDateTime(utcnow(),'MM'),'/','Day=',formatDateTime(utcnow(),'dd'))",
										"type": "Expression"
									},
									"watermarkColumnName": {
										"value": "@item().WatermarkColumnName",
										"type": "Expression"
									},
									"fileName": {
										"value": "@concat(item().SourceTableName,'-',formatDateTime(utcnow()) )",
										"type": "Expression"
									},
									"userName": {
										"value": "@item().UserName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_DatabaseName": {
				"type": "string",
				"defaultValue": "PricingandPromo"
			},
			"p_SourceSystem": {
				"type": "string",
				"defaultValue": "PosPromo"
			}
		},
		"folder": {
			"name": "Digital-Merchandising/SQLSERVER/Common"
		},
		"annotations": []
	}
}