							"name": "ExportDigitalProductEligibilityToServiceBus",
							"description": "It will run only ExportDigitalProductEligibilityToServiceBus notebook",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Published_Product/ProductAPI/GRC/ILC/SERVICEBUS/ExportDigitalProductEligibilityToServiceBus"
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks_Connector",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"entityName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/ATP"
		},
		"annotations": []
	}
