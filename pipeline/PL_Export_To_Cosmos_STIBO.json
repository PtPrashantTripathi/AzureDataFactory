{
	"name": "PL_Export_To_Cosmos_STIBO",
	"properties": {
		"activities": [
			{
				"name": "NB_Cosmos_Load",
				"description": "Master notebook to process each entity passed as parameter",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "PL_ScaleCosmos_Increase_RU",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/GRC/Product_CosmosDB/RunCosmosNotebook",
					"baseParameters": {
						"collectionname": {
							"value": "@pipeline().parameters.collectionname",
							"type": "Expression"
						},
						"fullorincl": {
							"value": "@pipeline().parameters.fullorincl",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_PubSub",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "PL_ScaleCosmos_Increase_RU",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Delete Previous Event File",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ScaleCosmos_Increase_RU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_CollectionName": {
							"value": "@pipeline().parameters.collectionname",
							"type": "Expression"
						},
						"fullorincl": {
							"value": "@pipeline().parameters.fullorincl",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "PL_ScaleCosmos_Decrease_RU",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "NB_Cosmos_Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ScaleCosmos_Decrease_RU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_CollectionName": {
							"value": "@pipeline().parameters.collectionname",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Generate Event for Collection run Completion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "PL_ScaleCosmos_Decrease_RU",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@concat(pipeline().parameters.collectionname,'_Collection_Completion.blob')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "PL_ScaleCosmos_Decrease_RU_fail",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "NB_Cosmos_Load",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ScaleCosmos_Decrease_RU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_CollectionName": {
							"value": "@pipeline().parameters.collectionname",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Generate Event for Collection run Completion_fail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "PL_ScaleCosmos_Decrease_RU_fail",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@concat(pipeline().parameters.collectionname,'_Collection_Completion.blob')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Delete Previous Event File",
				"type": "Delete",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Event_Blob",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@concat(pipeline().parameters.collectionname,'_Collection_Completion.blob')",
								"type": "Expression"
							}
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": false,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"collectionname": {
				"type": "string"
			},
			"fullorincl": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/stibo"
		},
		"annotations": [],
		"lastPublishTime": "2021-03-03T10:59:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
