{
	"name": "PL_VN_M_PA_TTS_CONTRACTUAL_SILVER_MASTER",
	"properties": {
		"activities": [
			{
				"name": "PL_SEAID_A_ONBOARDER_STAGE_BUILDER",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "AT_SET_LandingDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_SEAID_A_ONBOARDER_STAGE_BUILDER",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"source_name": {
							"value": "@pipeline().parameters.source_name",
							"type": "Expression"
						},
						"object_name": {
							"value": "@pipeline().parameters.object_name",
							"type": "Expression"
						},
						"country_code": {
							"value": "@pipeline().parameters.country_code",
							"type": "Expression"
						},
						"landing_date": {
							"value": "@variables('landing_date')",
							"type": "Expression"
						},
						"write_mode": "snapshot",
						"partition_keys": "Country",
						"table_name": "promoanalytics.tts_contractual"
					}
				}
			},
			{
				"name": "AT_SET_LandingDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "landing_date",
					"value": {
						"value": "@formatDateTime(convertTimeZone(utcNow(), 'UTC' , pipeline().parameters.time_zone), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"time_zone": {
				"type": "string",
				"defaultValue": "SE Asia Standard Time"
			},
			"source_name": {
				"type": "string",
				"defaultValue": "PromoAnalytics"
			},
			"object_name": {
				"type": "string",
				"defaultValue": "dim_vn_tts_contractual"
			},
			"country_code": {
				"type": "string",
				"defaultValue": "VN"
			}
		},
		"variables": {
			"landing_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "VN/PROMO_ANALYTICS"
		},
		"annotations": []
	}
}
