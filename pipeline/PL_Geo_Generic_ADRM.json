{
	"name": "PL_Geo_Generic_ADRM",
	"properties": {
		"activities": [
			{
				"name": "NB_process",
				"description": "Notebook for carrying out the cleansing activity",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "FLTR_Geo_Cluster_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Pos/UTILITIES/DimensionStageLoadUtility",
					"baseParameters": {
						"Domain": {
							"value": "@pipeline().parameters.Domain",
							"type": "Expression"
						},
						"SourceSystem": {
							"value": "@pipeline().parameters.SourceSystem",
							"type": "Expression"
						},
						"ETLGroup": {
							"value": "@pipeline().parameters.ETLGroup",
							"type": "Expression"
						},
						"EntityType": {
							"value": "@pipeline().parameters.EntityType",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_01",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "LKP_CLUSTER_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_GEO_CONFIG_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "GEO_DATABRICKS_CLUSTER_CONFIGURATION.CSV"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_Geo_Cluster_Config",
				"description": "Filter for Source tables in the configuration file",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CLUSTER_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CLUSTER_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(and(and(equals(item().Domain,'Geo')\n,equals(item().PipelineName,'PL_Geo_Generic_ADRM'))\n,equals(item().DatabricksActivityName,'NB_process'))\n,equals(item().ClusterType,'DS5'))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"EntityType": {
				"type": "string"
			},
			"ETLGroup": {
				"type": "string"
			},
			"SourceSystem": {
				"type": "string"
			},
			"Domain": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Geo/ADRM"
		},
		"annotations": [],
		"lastPublishTime": "2021-03-09T09:28:40Z"
	}
}