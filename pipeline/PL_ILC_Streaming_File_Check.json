{
	"name": "PL_ILC_Streaming_File_Check",
	"properties": {
		"activities": [
			{
				"name": "ILC_File_Check",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Published_Product/ProductAPI/ALERT/ILC_Streaming_File_Check"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_DS3",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "ILC_File_Check",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('ILC_File_Check').output.runOutput.key1,'True')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Environment_Selection",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Published_Product/ProductAPI/ALERT/IGNIO_ENVIRONMENT_SELECTION"
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_DS3",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "GetSecret",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Environment_Selection",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"url": {
									"value": "@activity('Environment_Selection').output.runOutput.URL1",
									"type": "Expression"
								},
								"method": "GET",
								"authentication": {
									"type": "MSI",
									"resource": "https://vault.azure.net"
								}
							}
						},
						{
							"name": "Alert_JSON_Config_Files",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "GetSecret",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"dataset": {
									"referenceName": "DS_JSON_Config_LookUp",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Ignio_Call",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Alert_JSON_Config_Files",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"url": {
									"value": "@activity('Environment_Selection').output.runOutput.URL",
									"type": "Expression"
								},
								"method": "POST",
								"headers": {
									"Ocp-Apim-Subscription-Key": {
										"value": "@activity('GetSecret').output.value",
										"type": "Expression"
									}
								},
								"body": {
									"value": "[\n  {\n    \"description\": \"ILC - Data is not getting processed by streaming jobs\",\n    \"faultName\": \"ILC - Data is not getting processed by streaming jobs\",\n    \"priority\": \"High\",\n    \"properties\": {\n      \"AssignedGroup\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.Assigned_Group}\",\n      \"AssignedSupportOrganization\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.Support_Group}\",\n      \"Ciname\": \"@{activity('Alert_JSON_Config_Files').output.firstRow.CI_Name}\",\n      \"Impact\": \"2-Significant/Large\",\n      \"Notes\": \"@{activity('ILC_File_Check').output.runOutput.key2}\" ,\n      \"ProductName\": \"EDaA - Product 360 (Product)\",\n      \"ServiceCI\": \"Meijer Services\",\n      \"Summary\": \"ILC - Data is not getting processed by streaming jobs\" ,\n      \"Urgency\": \"2-High\"\n    },\n    \"rootEntity\": \"RemedyCreate\",\n    \"severity\": \"High\",\n    \"source\": \"ignioAlertDetection\"\n  }\n]\n",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://management.azure.com"
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "ProductAPI/ILC_File_Check"
		},
		"annotations": []
	}
}
