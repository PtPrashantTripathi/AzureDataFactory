{
	"name": "PL_StageToServeADLS_DC_BOH_Load",
	"properties": {
		"description": "Copy data from Staged container to Serve",
		"activities": [
			{
				"name": "LKP_CONFIG_FILE",
				"description": "This activity reads from a source file located in configuration in the Data Lake",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_TeraData_CONFIG_Promo_CSV",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "LDE_OUTPUT_STAGED_TO_SERVEADLS_CONFIGURATION.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FLTR_SRC",
				"description": "",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LKP_CONFIG_FILE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_CONFIG_FILE').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().Domain,pipeline().parameters.p_Domain)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FOREACH_SRC_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLTR_SRC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLTR_SRC').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "StagedToServe",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Published_Product/ProductAPI/GRC/LDE/StageToServeADLS_DC_BOH",
								"baseParameters": {
									"entity_name": {
										"value": "@item().Entity",
										"type": "Expression"
									},
									"source_path": {
										"value": "@item().SourcePath",
										"type": "Expression"
									},
									"destination_path": {
										"value": "@item().DestinationPath",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks_01",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_Domain": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/LDE"
		},
		"annotations": []
	}
}
