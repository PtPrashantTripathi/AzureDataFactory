{
	"name": "PL_CreatePostProcess",
	"properties": {
		"activities": [
			{
				"name": "Update PostProcess File",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "00.00:15:00",
					"retry": 3,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "SRC_Name",
								"value": {
									"value": "@pipeline().parameters.sourceSystem",
									"type": "Expression"
								}
							},
							{
								"name": "SRC_Table",
								"value": {
									"value": "@pipeline().parameters.tableName",
									"type": "Expression"
								}
							},
							{
								"name": "Last_Modified_Timestamp",
								"value": {
									"value": "2020-06-02T09:12:15",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "SRC_Name",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Name"
								}
							},
							{
								"source": {
									"name": "SRC_Table",
									"type": "String"
								},
								"sink": {
									"name": "SRC_Table"
								}
							},
							{
								"source": {
									"name": "Last_Modified_Timestamp",
									"type": "String"
								},
								"sink": {
									"name": "Last_Modified_Timestamp"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_COMM_CONTROL_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_COMM_POSTPROCESS_CSV",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@pipeline().parameters.tableName",
								"type": "Expression"
							},
							"domain": {
								"value": "@pipeline().parameters.domain",
								"type": "Expression"
							},
							"sourceSystem": {
								"value": "@pipeline().parameters.sourceSystem",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"domain": {
				"type": "string"
			},
			"sourceSystem": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ProductAPI/Datastage"
		},
		"annotations": []
	}
}
